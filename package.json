{
  "name": "who-am-i",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:party\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w @who-am-i/web",
    "dev:party": "partykit dev",
    "build": "npm run build -w @who-am-i/web",
    "build:deck": "node scripts/build-deck.mjs",
    "import:pool": "node scripts/import-pool-csv.mjs",
    "setup:deck": "npm run import:pool",
    "fetch:images": "node scripts/fetch-deck-images.mjs --only-missing",
    "fetch:images:all": "node scripts/fetch-deck-images.mjs --only-missing --force",
    "fetch:text": "node scripts/fetch-deck-images.mjs --refresh-text --force",
    "sync:images": "node scripts/sync-deck-images.mjs",
    "party:deploy": "partykit deploy",
    "ship": "node scripts/ship.mjs",
    "fetch:posters": "node scripts/fetch-category-posters.mjs",
    "generate:sfx": "node scripts/generate-sfx.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "partykit": "^0.0.115",
    "typescript": "^5.8.3"
  }
}
